# DataOrbyt — environment variables (all optional for the demo).
# Copy to .env.local. Never prefix secrets with NEXT_PUBLIC_ — that would ship them to the browser.

# Port for `npm run dev` (defaults to 3000).
# PORT=3000

# Optional fixed MCP bearer token for local testing (>= 16 chars). Grants read + draft scopes to all projects.
# Prefer creating scoped tokens in Settings → API tokens instead.
# DATAORBYT_MCP_DEV_TOKEN=change-me-to-a-long-random-string

# Comma-separated browser origins allowed to call POST /mcp (non-browser MCP clients send no Origin and are allowed).
# DATAORBYT_ALLOWED_ORIGINS=https://app.example.com

# ---- Not used yet: what real integrations will need (see README "Going real") ----
# DATABASE_URL=postgres://...                 # persistent store replacing the in-memory demo store
# SECRETS_BACKEND=gcp-secret-manager          # where connection credentials are kept
# BIGQUERY_PROJECT= / BIGQUERY_KEYFILE_PATH=  # warehouse adapter
# SNOWFLAKE_ACCOUNT= / SNOWFLAKE_USER= / SNOWFLAKE_PRIVATE_KEY_PATH=
# DBT_PROJECT_DIR= / DBT_TARGET=prod          # real dbt runner
# SLACK_BOT_TOKEN= / SMTP_URL=                # real alert delivery
